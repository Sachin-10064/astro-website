---
// Header.astro - Glassmorphism Header Component
---

<header
  class="right-0 z-50 transition-all duration-300 backdrop-blur-xl bg-[#0d1330]/65 border-b border-white/10 shadow-[0_4px_30px_rgba(0,0,0,0.1)]"
>
  <div
    class="max-w-7xl mx-auto px-6 sm:px-8 h-20 flex items-center justify-between"
  >
    <!-- Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div
        class="w-10 h-10 rounded-xl bg-linear-to-tr from-[#a4e500] to-[#b6f414] flex items-center justify-center text-[#101744] font-black text-xl shadow-[0_0_20px_rgba(164,229,0,0.4)] group-hover:scale-105 transition-transform"
      >
        B
      </div>
      <div class="flex flex-col">
        <span
          class="font-['Michroma',sans-serif] text-sm tracking-wider font-extrabold text-white group-hover:text-[#a4e500] transition-colors"
        >
          BPMP
        </span>
        <span class="text-[10px] text-slate-400 tracking-widest uppercase">
          Interactive
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
      <a
        href="#why-bpmp"
        class="text-slate-300 hover:text-[#a4e500] transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#a4e500] hover:after:w-full after:transition-all"
      >
        Why BPMP
      </a>
      <a
        href="#therapy"
        class="text-slate-300 hover:text-[#a4e500] transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#a4e500] hover:after:w-full after:transition-all"
      >
        Therapy Section
      </a>
      <a
        href="#services"
        class="text-slate-300 hover:text-[#a4e500] transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#a4e500] hover:after:w-full after:transition-all"
      >
        Services
      </a>
      <a
        href="#about"
        class="text-slate-300 hover:text-[#a4e500] transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#a4e500] hover:after:w-full after:transition-all"
      >
        About Us
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      <a
        href="#contact"
        class="relative inline-flex items-center justify-center px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wide text-[#101744] bg-[#a4e500] hover:bg-[#b8f514] rounded-full shadow-[0_0_25px_rgba(164,229,0,0.35)] hover:shadow-[0_0_35px_rgba(164,229,0,0.55)] transition-all transform hover:-translate-y-0.5"
      >
        Get Started
        <svg
          class="w-4 h-4 ml-1.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="md:hidden p-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white transition-colors border border-white/10"
        aria-label="Toggle navigation"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
