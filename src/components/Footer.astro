---
// Footer.astro - Modern Dark Footer Component
---

<footer class="bg-[#070a1a] text-slate-300 border-t border-white/10 relative overflow-hidden">
  <!-- Glowing Background Accent -->
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-150 h-75 bg-[#a4e500]/10 blur-[140px] pointer-events-none rounded-full" />

  <div class="max-w-7xl mx-auto px-6 sm:px-8 pt-16 pb-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      
      <!-- Brand Info -->
      <div class="md:col-span-5 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-linear-to-tr from-[#a4e500] to-[#b6f414] flex items-center justify-center text-[#101744] font-black text-xl shadow-[0_0_20px_rgba(164,229,0,0.3)]">
            B
          </div>
          <span class="font-['Michroma',sans-serif] text-xl font-extrabold text-white tracking-wider">
            BPMP
          </span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-md font-light">
          Turning visionary ideas into high-impact capital projects and empowering personal growth through modern, structured interactive solutions.
        </p>
        
        <!-- Social Icons -->
        <div class="flex items-center gap-3 mt-2">
          {['Twitter', 'LinkedIn', 'Instagram', 'GitHub'].map((name) => (
            <a
              href="#"
              aria-label={name}
              class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-[#a4e500] hover:bg-white/10 hover:border-[#a4e500]/40 transition-all text-xs font-semibold"
            >
              {name[0]}
            </a>
          ))}
        </div>
      </div>

      <!-- Links Column 1: Solutions -->
      <div class="md:col-span-2 flex flex-col gap-4">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white font-['Michroma',sans-serif]">
          Solutions
        </h4>
        <ul class="flex flex-col gap-2.5 text-sm text-slate-400">
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Capital Projects</a></li>
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Talk Therapy</a></li>
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Couples Counseling</a></li>
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Family Therapy</a></li>
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Group Sessions</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Company -->
      <div class="md:col-span-2 flex flex-col gap-4">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white font-['Michroma',sans-serif]">
          Company
        </h4>
        <ul class="flex flex-col gap-2.5 text-sm text-slate-400">
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">About Us</a></li>
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Methodology</a></li>
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Careers</a></li>
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Press & News</a></li>
          <li><a href="#" class="hover:text-[#a4e500] transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Newsletter Column -->
      <div class="md:col-span-3 flex flex-col gap-4">
        <h4 class="text-xs font-bold uppercase tracking-widest text-white font-['Michroma',sans-serif]">
          Stay Informed
        </h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Subscribe to our newsletter for insights on capital deployment and personal growth.
        </p>
        <form class="flex flex-col gap-2" onsubmit="event.preventDefault()">
          <div class="relative">
            <input
              type="email"
              placeholder="Enter your email"
              class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#a4e500] focus:ring-1 focus:ring-[#a4e500] transition-all"
            />
            <button
              type="submit"
              class="absolute right-1.5 top-1.5 bottom-1.5 px-3 bg-[#a4e500] hover:bg-[#b8f514] text-[#101744] font-bold rounded-lg text-xs transition-colors"
            >
              Join
            </button>
          </div>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {new Date().getFullYear()} BPMP Interactive Inc. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-slate-300 transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-slate-300 transition-colors">Security</a>
      </div>
    </div>
  </div>
</footer>
